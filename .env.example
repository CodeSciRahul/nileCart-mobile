# Direct API base URL (must include /api). Use LAN IP for physical devices.
# Example: http://192.168.1.10:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Flutterwave return URL for AuthSession (must match server MOBILE_PAYMENT_REDIRECT_URL).
# Production example: nilescart://checkout/payment/callback
# If unset, the app uses Linking.createURL("/checkout/payment/callback").
# EXPO_PUBLIC_PAYMENT_REDIRECT_URL=nilescart://checkout/payment/callback
